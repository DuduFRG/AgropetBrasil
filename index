<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  /* ============================================
     TOKENS
  ============================================ */
  :root{
    --cream:   #F7F2E7;
    --paper:   #FFFDF8;
    --forest:  #1F4D36;
    --forest-2:#28614A;
    --clay:    #C1622D;
    --butter:  #F2B705;
    --ink:     #2B2620;
    --sage:    #DCE8DB;

    --font-display: 'Fraunces', serif;
    --font-body: 'Work Sans', sans-serif;
    --font-mono: 'Space Mono', monospace;

    --container: 1180px;
    --radius: 14px;
    --section-pad: clamp(4rem, 8vw, 7rem);
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--cream);
    color:var(--ink);
    font-family:var(--font-body);
    font-size:1rem;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  img{ max-width:100%; display:block; }
  a{ color:inherit; }
  ul{ margin:0; padding:0; list-style:none; }
  h1,h2,h3,h4{
    font-family:var(--font-display);
    font-weight:600;
    line-height:1.08;
    margin:0;
    letter-spacing:-0.01em;
  }
  p{ margin:0; }

  .container{
    max-width:var(--container);
    margin-inline:auto;
    padding-inline:clamp(1.25rem, 4vw, 2.75rem);
  }
  .section{ padding-block:var(--section-pad); }
  .section--sage{ background:var(--sage); }
  .section--forest{ background:var(--forest); color:var(--cream); }
  .section--paper{ background:var(--paper); }

  .eyebrow{
    font-family:var(--font-mono);
    font-size:0.78rem;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--clay);
    margin:0 0 0.9rem;
    display:flex;
    align-items:center;
    gap:0.6rem;
  }
  .eyebrow::before{
    content:"";
    display:inline-block;
    width:22px;
    height:2px;
    background:var(--clay);
  }
  .section--forest .eyebrow{ color:var(--butter); }
  .section--forest .eyebrow::before{ background:var(--butter); }

  h2{ font-size:clamp(2rem, 3.6vw, 2.9rem); }
  .section-head{ max-width:640px; margin-bottom:3rem; }
  .section-head p{ margin-top:0.9rem; color:#5a5247; font-size:1.05rem; }
  .section--forest .section-head p{ color:#cfe3d8; }

  /* Reveal-on-scroll */
  .reveal{ opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.is-visible{ opacity:1; transform:translateY(0); }
  @media (prefers-reduced-motion: reduce){
    .reveal{ opacity:1; transform:none; transition:none; }
    html{ scroll-behavior:auto; }
  }

  /* ============================================
     BUTTONS
  ============================================ */
  .btn{
    display:inline-flex;
    align-items:center;
    gap:0.5rem;
    font-family:var(--font-body);
    font-weight:600;
    font-size:0.95rem;
    padding:0.85rem 1.6rem;
    border-radius:999px;
    text-decoration:none;
    border:2px solid transparent;
    transition:transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
    white-space:nowrap;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn-primary{ background:var(--clay); color:var(--paper); }
  .btn-primary:hover{ background:#a8501f; }
  .btn-ghost{ background:transparent; border-color:var(--forest); color:var(--forest); }
  .btn-ghost:hover{ background:var(--forest); color:var(--cream); }
  .section--forest .btn-ghost{ border-color:var(--cream); color:var(--cream); }
  .section--forest .btn-ghost:hover{ background:var(--cream); color:var(--forest); }
  .btn:focus-visible{ outline:3px solid var(--butter); outline-offset:2px; }

  /* ============================================
     HEADER
  ============================================ */
  .site-header{
    position:sticky; top:0; z-index:50;
    background:rgba(247,242,231,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid rgba(43,38,32,0.08);
  }
  .header-inner{
    display:flex; align-items:center; justify-content:space-between;
    gap:1.5rem; padding-block:0.9rem;
  }
  .logo{
    display:flex; align-items:center; gap:0.6rem;
    text-decoration:none; color:var(--ink);
    font-family:var(--font-display); font-weight:700; font-size:1.25rem;
  }
  .logo .paw{ width:30px; height:30px; color:var(--clay); flex-shrink:0; }
  .logo strong{ color:var(--forest); }

  .nav{ display:flex; gap:2rem; align-items:center; }
  .nav a{
    text-decoration:none; font-weight:600; font-size:0.95rem;
    color:var(--ink); position:relative; padding-bottom:4px;
  }
  .nav a::after{
    content:""; position:absolute; left:0; bottom:0; width:0; height:2px;
    background:var(--clay); transition:width .25s ease;
  }
  .nav a:hover::after{ width:100%; }

  .header-cta{ flex-shrink:0; }
  .nav-toggle{
    display:none; background:none; border:2px solid var(--forest);
    border-radius:8px; width:42px; height:42px; cursor:pointer;
    position:relative;
  }
  .nav-toggle span, .nav-toggle span::before, .nav-toggle span::after{
    content:""; position:absolute; left:9px; right:9px; height:2px; background:var(--forest);
    transition:transform .2s ease, opacity .2s ease;
  }
  .nav-toggle span{ top:50%; transform:translateY(-50%); }
  .nav-toggle span::before{ top:-8px; }
  .nav-toggle span::after{ top:8px; }
  .nav-toggle.is-open span{ background:transparent; }
  .nav-toggle.is-open span::before{ top:0; transform:rotate(45deg); }
  .nav-toggle.is-open span::after{ top:0; transform:rotate(-45deg); }

  @media (max-width:880px){
    .nav{
      position:absolute; top:100%; left:0; right:0;
      background:var(--cream); border-bottom:1px solid rgba(43,38,32,0.08);
      flex-direction:column; align-items:flex-start; gap:0;
      max-height:0; overflow:hidden; transition:max-height .3s ease;
    }
    .nav.is-open{ max-height:320px; }
    .nav a{ padding:0.9rem clamp(1.25rem,4vw,2.75rem); width:100%; }
    .nav a::after{ display:none; }
    .header-cta{ display:none; }
    .nav-toggle{ display:block; }
  }

  /* ============================================
     HERO
  ============================================ */
  .hero{ padding-block: clamp(3rem, 7vw, 6rem) 0; overflow:hidden; }
  .hero-inner{
    display:grid; grid-template-columns:1.05fr 0.95fr; gap:clamp(2rem,5vw,4rem);
    align-items:center;
  }
  .hero h1{ font-size:clamp(2.6rem, 5.4vw, 4.4rem); margin-block:1rem 1.3rem; }
  .hero h1 em{ font-style:italic; color:var(--forest); }
  .hero-lede{ font-size:1.12rem; color:#5a5247; max-width:34ch; }
  .hero-actions{ display:flex; flex-wrap:wrap; gap:1rem; margin-top:2rem; }

  .hero-meta{
    display:flex; flex-wrap:wrap; gap:1.6rem; margin-top:2.6rem;
    font-family:var(--font-mono); font-size:0.8rem; letter-spacing:0.04em;
    color:var(--forest);
  }
  .hero-meta strong{ display:block; font-family:var(--font-display); font-size:1.15rem; color:var(--ink); }

  .hero-media{ position:relative; }
  .hero-photo{
    position:relative; margin:0;
    background:var(--paper); padding:0.9rem 0.9rem 2.4rem;
    border-radius:6px; box-shadow:0 18px 40px -18px rgba(43,38,32,0.45);
    transform:rotate(-2.5deg);
    max-width:420px; margin-inline:auto;
  }
  .hero-photo img{ border-radius:2px; width:100%; aspect-ratio:4/5; object-fit:cover; }
  .hero-photo figcaption{
    font-family:var(--font-mono); font-size:0.72rem; letter-spacing:0.08em;
    text-transform:uppercase; color:#9c9285; text-align:center; margin-top:0.6rem;
  }
  .hero-photo::before{
    content:""; position:absolute; top:-14px; left:50%; transform:translateX(-50%) rotate(-4deg);
    width:90px; height:28px; background:rgba(242,183,5,0.55);
  }
  .stamp{
    position:absolute; bottom:-30px; right:-26px;
    width:128px; height:128px; border-radius:50%;
    border:2px dashed var(--clay);
    background:var(--cream);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; transform:rotate(11deg);
    font-family:var(--font-mono); color:var(--forest);
    box-shadow:0 10px 24px -12px rgba(43,38,32,0.4);
  }
  .stamp .stamp-rating{ font-size:1.5rem; font-weight:700; letter-spacing:0.02em; }
  .stamp .stamp-stars{ color:var(--butter); font-size:0.9rem; letter-spacing:0.15em; margin-block:0.15rem; }
  .stamp .stamp-label{ font-size:0.55rem; letter-spacing:0.12em; text-transform:uppercase; max-width:80px; }

  @media (max-width:960px){
    .hero-inner{ grid-template-columns:1fr; text-align:left; }
    .hero-media{ order:-1; margin-bottom:1rem; }
    .hero-photo{ max-width:280px; }
    .stamp{ width:104px; height:104px; right:-10px; bottom:-22px; }
  }

  /* ============================================
     PAW TRAIL DIVIDER
  ============================================ */
  .paw-trail{
    position:relative; height:64px; margin-top:clamp(2rem,6vw,4rem);
    overflow:hidden;
  }
  .paw-trail .paw{
    position:absolute; width:30px; height:30px; color:var(--forest); opacity:0.35;
  }

  /* ============================================
     SOBRE
  ============================================ */
  .sobre-grid{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,4rem); align-items:start; }
  .sobre-grid p + p{ margin-top:1.1rem; }
  .sobre-grid .lede{ color:#5a5247; font-size:1.05rem; }
  .tag-list{ display:flex; flex-wrap:wrap; gap:0.7rem; margin-top:2rem; }
  .tag{
    font-family:var(--font-mono); font-size:0.75rem; letter-spacing:0.08em; text-transform:uppercase;
    border:1px solid var(--forest); color:var(--forest); border-radius:999px;
    padding:0.45rem 1.05rem;
  }
  .stat-row{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:1rem;
  }
  .stat{ border-top:2px solid var(--forest); padding-top:0.9rem; }
  .stat strong{ display:block; font-family:var(--font-display); font-size:2rem; color:var(--forest); }
  .stat span{ font-family:var(--font-mono); font-size:0.72rem; letter-spacing:0.08em; text-transform:uppercase; color:#7c7468; }

  @media (max-width:880px){
    .sobre-grid{ grid-template-columns:1fr; }
    .stat-row{ grid-template-columns:repeat(3,1fr); gap:1rem; }
    .stat strong{ font-size:1.5rem; }
  }

  /* ============================================
     SERVICOS (ficha cards)
  ============================================ */
  .grid-3{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.75rem; }
  .ficha{
    background:var(--paper); border-radius:var(--radius);
    padding:2.1rem 1.9rem; position:relative;
    box-shadow:0 14px 34px -22px rgba(43,38,32,0.35);
    border:1px solid rgba(43,38,32,0.06);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .ficha:hover{ transform:translateY(-6px) rotate(-0.6deg); box-shadow:0 22px 40px -20px rgba(43,38,32,0.4); }
  .ficha .ficha-num{
    font-family:var(--font-mono); font-size:0.72rem; letter-spacing:0.18em;
    color:var(--clay); display:block; margin-bottom:1.1rem;
  }
  .ficha .paw{ width:34px; height:34px; color:var(--forest); margin-bottom:1rem; }
  .ficha h3{ font-size:1.35rem; margin-bottom:0.7rem; }
  .ficha p{ color:#5a5247; font-size:0.97rem; }
  .ficha::after{
    content:""; position:absolute; inset:10px; border:1px dashed rgba(43,38,32,0.12);
    border-radius:8px; pointer-events:none;
  }

  @media (max-width:960px){ .grid-3{ grid-template-columns:1fr; } }

  /* ============================================
     GALERIA
  ============================================ */
  .grid-4{ display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
  .insta-card{
    background:var(--cream); border:1px solid rgba(43,38,32,0.08);
    border-radius:var(--radius); padding:1.7rem 1.4rem; text-align:left;
    transition:transform .25s ease, border-color .25s ease;
  }
  .insta-card:hover{ transform:translateY(-4px); border-color:var(--clay); }
  .insta-card .paw{ width:28px; height:28px; color:var(--clay); margin-bottom:0.9rem; }
  .insta-card h4{ font-size:1.05rem; margin-bottom:0.4rem; font-family:var(--font-body); font-weight:700; }
  .insta-card p{ font-size:0.9rem; color:#5a5247; }
  .galeria-cta{
    margin-top:2.5rem; display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:1.2rem; padding:1.6rem 1.9rem; background:var(--forest); color:var(--cream);
    border-radius:var(--radius);
  }
  .galeria-cta p{ font-family:var(--font-display); font-size:1.2rem; }
  .galeria-cta .btn-primary{ background:var(--butter); color:var(--ink); }
  .galeria-cta .btn-primary:hover{ background:#d9a400; }

  @media (max-width:960px){ .grid-4{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:560px){ .grid-4{ grid-template-columns:1fr; } }

  /* ============================================
     DEPOIMENTOS
  ============================================ */
  .grid-testimonials{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.75rem; }
  .postcard{
    background:var(--paper); border-radius:var(--radius); padding:2rem 1.8rem;
    border:1px solid rgba(43,38,32,0.06); position:relative;
    box-shadow:0 14px 34px -22px rgba(43,38,32,0.3);
  }
  .postcard .stars{ color:var(--butter); font-size:1rem; letter-spacing:0.18em; }
  .postcard p.quote{
    font-family:var(--font-display); font-size:1.18rem; line-height:1.4; margin:1rem 0 1.4rem;
  }
  .postcard .source{
    font-family:var(--font-mono); font-size:0.74rem; letter-spacing:0.08em; text-transform:uppercase;
    color:#9c9285;
  }
  @media (max-width:960px){ .grid-testimonials{ grid-template-columns:1fr; } }

  /* ============================================
     CONTATO
  ============================================ */
  .contato-grid{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,4rem); align-items:stretch; }
  .info-list{ display:flex; flex-direction:column; gap:1.6rem; margin-bottom:2.2rem; }
  .info-item{ display:flex; gap:1rem; }
  .info-item .paw{ width:26px; height:26px; color:var(--butter); flex-shrink:0; margin-top:0.2rem; }
  .info-item h4{ font-family:var(--font-body); font-size:0.78rem; letter-spacing:0.14em; text-transform:uppercase; color:#cfe3d8; margin-bottom:0.3rem; }
  .info-item p{ font-size:1.02rem; }
  .hours-table{ width:100%; border-collapse:collapse; font-size:0.95rem; }
  .hours-table td{ padding:0.4rem 0; border-bottom:1px solid rgba(247,242,231,0.15); }
  .hours-table td:last-child{ text-align:right; font-family:var(--font-mono); font-size:0.85rem; }
  .contato-actions{ display:flex; flex-wrap:wrap; gap:1rem; margin-top:2.2rem; }
  .map-frame{
    border-radius:var(--radius); overflow:hidden; min-height:380px;
    border:1px solid rgba(247,242,231,0.15);
  }
  .map-frame iframe{ width:100%; height:100%; min-height:380px; border:0; display:block; }

  @media (max-width:880px){ .contato-grid{ grid-template-columns:1fr; } }

  /* ============================================
     FOOTER
  ============================================ */
  .site-footer{ background:var(--ink); color:var(--cream); padding-block:3.5rem 2rem; }
  .footer-inner{
    display:flex; flex-wrap:wrap; justify-content:space-between; gap:2.5rem;
    padding-bottom:2.5rem; border-bottom:1px solid rgba(247,242,231,0.12);
  }
  .footer-brand .logo{ color:var(--cream); }
  .footer-brand .logo strong{ color:var(--butter); }
  .footer-brand p{ margin-top:0.9rem; max-width:30ch; color:#cabfb1; font-size:0.95rem; }
  .footer-nav{ display:flex; gap:3rem; flex-wrap:wrap; }
  .footer-nav h4{ font-family:var(--font-mono); font-size:0.75rem; letter-spacing:0.14em; text-transform:uppercase; color:#cabfb1; margin-bottom:1rem; }
  .footer-nav ul{ display:flex; flex-direction:column; gap:0.6rem; }
  .footer-nav a{ text-decoration:none; font-size:0.95rem; color:var(--cream); transition:color .2s; }
  .footer-nav a:hover{ color:var(--butter); }
  .footer-bottom{
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem;
    padding-top:1.5rem; font-size:0.82rem; color:#9c9285; font-family:var(--font-mono);
  }
  .footer-bottom a{ color:#cabfb1; text-decoration:underline; }

  @media (max-width:600px){
    .footer-inner{ flex-direction:column; }
    .footer-nav{ gap:2rem; }
  }
</style>
</head>
<body>

<!-- shared paw icon -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="paw" viewBox="0 0 100 100">
    <ellipse cx="50" cy="66" rx="26" ry="22"/>
    <ellipse cx="23" cy="38" rx="11" ry="14" transform="rotate(-22 23 38)"/>
    <ellipse cx="42" cy="22" rx="11" ry="14"/>
    <ellipse cx="62" cy="22" rx="11" ry="14"/>
    <ellipse cx="80" cy="38" rx="11" ry="14" transform="rotate(22 80 38)"/>
  </symbol>
</svg>

<!-- ============================================
     HEADER
============================================ -->
<header class="site-header">
  <div class="container header-inner">
    <a href="#home" class="logo">
      <svg class="paw" fill="currentColor"><use href="#paw"/></svg>
      <span>AgroPet <strong>Brasil</strong></span>
    </a>
    <nav class="nav" id="nav">
      <a href="#sobre">Sobre</a>
      <a href="#servicos">Serviços</a>
      <a href="#galeria">Galeria</a>
      <a href="#depoimentos">Depoimentos</a>
      <a href="#contato">Visite-nos</a>
    </nav>
    <a class="btn btn-primary header-cta" href="https://wa.me/message/JJMV6MNNFBH5D1" target="_blank" rel="noopener">Fale no WhatsApp</a>
    <button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false"><span></span></button>
  </div>
</header>

<main>
  <!-- ============================================
       HERO
  ============================================ -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-content reveal">
        <p class="eyebrow">5ª Avenida, 1931 · Municípios · Balneário Camboriú</p>
        <h1>Tudo para o seu pet, <em>com amor e cuidado de verdade.</em></h1>
        <p class="hero-lede">Agropecuária, pet shop e banho &amp; tosa em um só endereço — cuidando dos bichinhos (e das famílias) do bairro Municípios, com a confiança de quem já conhece cada cliente pelo nome.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://wa.me/message/JJMV6MNNFBH5D1" target="_blank" rel="noopener">Agendar banho e tosa</a>
          <a class="btn btn-ghost" href="#servicos">Ver serviços</a>
        </div>
        <div class="hero-meta">
          <div><strong>5.0 ★</strong>nota no Google</div>
          <div><strong>25</strong>avaliações</div>
          <div><strong>726+</strong>momentos no Instagram</div>
        </div>
      </div>
      <div class="hero-media reveal">
        <figure class="hero-photo">
          <img src="data:image/jpeg;base64," alt="Fachada da loja Agropet Brasil na 5ª Avenida, Balneário Camboriú" loading="lazy">
          <figcaption>Nossa loja na 5ª Avenida, 1931</figcaption>
          <div class="stamp">
            <span class="stamp-rating">5.0</span>
            <span class="stamp-stars">★★★★★</span>
            <span class="stamp-label">25 avaliações Google</span>
          </div>
        </figure>
      </div>
    </div>
    <div class="paw-trail" id="pawTrail" aria-hidden="true"></div>
  </section>

  <!-- ============================================
       SOBRE
  ============================================ -->
  <section class="section section--paper" id="sobre">
    <div class="container">
      <div class="sobre-grid">
